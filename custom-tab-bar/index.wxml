<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-link {{selected === index ? 'is-on' : ''}}"
    data-index="{{index}}"
    bindtap="onTap"
  >
    <view class="tab-ic" style="-webkit-mask-image: url({{uris[item.icon]}}); mask-image: url({{uris[item.icon]}});"></view>
    <text class="tab-tx">{{item.text}}</text>
  </view>
</view>
