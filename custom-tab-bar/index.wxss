.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 64px;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(246, 251, 245, 0.90);
  box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.04);
  z-index: 50;
}
.tab-link {
  color: #727973;
  border-radius: 14px;
  padding: 6px 12px;
  min-width: 56px;
  min-height: 44px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tab-link.is-on {
  color: #032517;
  background: #c7ebd4;
  font-weight: 600;
}
.tab-ic {
  width: 24px;
  height: 24px;
  background-color: currentColor;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-size: contain;
  mask-size: contain;
  flex: none;
}
.tab-tx {
  font-size: 12px;
  line-height: 16px;
  font-weight: 600;
  margin-top: 2px;
}
