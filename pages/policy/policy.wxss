.page-body { padding-top: 12px; }

.gutter {
  margin-left: 16px;
  margin-right: 16px;
}

.kicker {
  display: block;
  font-family: var(--sans);
  font-size: 10px;
  line-height: 14px;
  font-weight: 700;
  color: var(--secondary);
  letter-spacing: 0.1em;
}

.doc-title {
  display: block;
  margin-top: 4px;
  min-width: 0;
  word-break: break-word;
}

.doc-lead {
  display: block;
  color: var(--on-surface-variant);
  margin-top: 8px;
  line-height: 1.625;
  min-width: 0;
  word-break: break-word;
}

.block {
  width: auto;
  margin: 20px 16px 0;
  padding: 16px;
  border-radius: 16px;
  background: var(--surface-container-lowest);
  box-shadow: 0 1px 2px rgba(3, 37, 23, 0.06);
}

.block + .block { margin-top: 16px; }

.block-n {
  display: block;
  color: var(--secondary);
}

.block-title {
  display: block;
  margin-top: 4px;
  min-width: 0;
  word-break: break-word;
}

.block-body {
  display: block;
  color: var(--on-surface-variant);
  margin-top: 8px;
  line-height: 1.625;
  min-width: 0;
  word-break: break-word;
}

.btn-row {
  display: flex;
  gap: 8px;
  margin: 24px 16px 0;
}

.btn-pri,
.btn-sec {
  flex: 1;
  height: 44px;
  border-radius: 12px;
  font-family: var(--sans);
  font-size: 12px;
  line-height: 44px;
  font-weight: 600;
}

.btn-pri {
  background: var(--primary);
  color: var(--on-primary);
}

.btn-sec {
  background: var(--surface-container-high);
  color: var(--on-surface);
}
