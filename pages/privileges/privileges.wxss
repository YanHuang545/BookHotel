.page-body { padding-top: 12px; }

.gutter {
  margin-left: 16px;
  margin-right: 16px;
}

.hero {
  position: relative;
  height: 176px;
  width: auto;
  margin: 0 16px 16px;
  border-radius: 16px;
  overflow: hidden;
}

.hero-img,
image.hero-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 176px;
  display: block;
  flex: none;
}

.hero-grad {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(to top, #032517, rgba(3, 37, 23, 0.50), rgba(0, 0, 0, 0.10));
}

.hero-copy {
  position: absolute;
  left: 16px;
  right: 16px;
  bottom: 12px;
  color: var(--on-primary);
  min-width: 0;
}

.hero-kicker {
  display: block;
  font-family: var(--sans);
  font-size: 10px;
  line-height: 14px;
  font-weight: 700;
  color: var(--secondary-fixed-dim);
  letter-spacing: 0.1em;
}

.hero-title {
  display: block;
  color: var(--on-primary);
  margin-top: 2px;
}

.hero-desc {
  display: block;
  color: var(--on-primary-container);
  margin-top: 4px;
  min-width: 0;
  word-break: break-word;
}

.hero-cd {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 8px;
  min-width: 0;
}

.chip-hot {
  background: var(--error);
  color: var(--on-error);
}

.cd-label { color: var(--surface-variant); flex: none; }

.cd-nums {
  display: flex;
  align-items: center;
  gap: 1px;
  flex: none;
}

.sec-title {
  display: block;
  margin-bottom: 8px;
}

.perk-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 12px 20px;
}

.perk-cell {
  width: 50%;
  padding: 4px;
  box-sizing: border-box;
}

.perk-card {
  display: flex;
  gap: 10px;
  min-width: 0;
  height: 100%;
  padding: 12px;
  border-radius: 12px;
  background: var(--surface-container-lowest);
  box-shadow: 0 1px 2px rgba(3, 37, 23, 0.06);
}

.perk-ico {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(120, 89, 45, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.perk-copy {
  flex: 1;
  min-width: 0;
}

.perk-name {
  display: block;
  min-width: 0;
  word-break: break-word;
}

.perk-desc {
  display: block;
  color: var(--on-surface-variant);
  margin-top: 2px;
  min-width: 0;
  word-break: break-word;
}

.pack-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin: 0 16px 10px;
  min-width: 0;
}

.pack-hint {
  color: var(--on-surface-variant);
  flex: none;
}

.pack-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.pack-card {
  position: relative;
  height: 176px;
  width: auto;
  margin: 0 16px;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 20px -2px rgba(3, 37, 23, 0.05);
}

.pack-cover,
image.pack-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 176px;
  display: block;
  flex: none;
}

.pack-hot {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 10;
  border-radius: 999px;
  background: var(--error);
  color: var(--on-error);
}

.pack-grad {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  padding: 12px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: linear-gradient(to top, rgba(3, 37, 23, 0.80), transparent 55%);
}

.pack-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8px;
  min-width: 0;
  color: var(--on-primary);
}

.pack-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.pack-title {
  color: var(--surface-bright);
  line-height: 1;
  min-width: 0;
  word-break: break-word;
}

.pack-sub {
  color: var(--surface-variant);
  line-height: 1;
  margin-top: 4px;
  min-width: 0;
  word-break: break-word;
}

.pack-price { flex: none; align-items: flex-end; }

.pack-yen {
  color: var(--secondary-fixed);
  line-height: 1;
}

.pack-unit {
  color: var(--surface-variant);
  line-height: 1;
}

.btn-row {
  display: flex;
  gap: 8px;
  margin: 20px 16px 0;
}

.btn-pri,
.btn-sec {
  flex: 1;
  height: 44px;
  border-radius: 12px;
  font-family: var(--sans);
  font-size: 12px;
  line-height: 44px;
  font-weight: 600;
}

.btn-pri {
  background: var(--primary);
  color: var(--on-primary);
}

.btn-sec { background: var(--surface-container-high); color: var(--on-surface); }

.foot {
  display: block;
  text-align: center;
  color: var(--outline);
  margin-top: 16px;
}
