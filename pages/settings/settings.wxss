.page-body { padding-top: 12px; }

.st-hero {
  position: relative;
  overflow: hidden;
  width: auto;
  margin: 0 16px;
  padding: 16px;
  border-radius: 16px;
  background: var(--primary);
  color: var(--on-primary);
}

.st-blob {
  position: absolute;
  right: -32px;
  bottom: -40px;
  width: 128px;
  height: 128px;
  border-radius: 50%;
  background: rgba(255, 221, 180, 0.15);
}

.st-hero-copy { position: relative; z-index: 1; min-width: 0; }

.st-kicker {
  display: block;
  font-family: var(--sans);
  font-size: 10px;
  line-height: 14px;
  font-weight: 700;
  color: var(--secondary-fixed-dim);
  letter-spacing: 0.1em;
}

.st-hero-title {
  display: block;
  color: var(--on-primary);
  margin-top: 4px;
}

.st-hero-desc {
  display: block;
  color: var(--on-primary-container);
  margin-top: 4px;
  min-width: 0;
  word-break: break-word;
}

.st-user {
  display: flex;
  align-items: center;
  gap: 12px;
  width: auto;
  margin: 16px 16px 0;
  padding: 16px;
  border-radius: 16px;
  background: var(--surface-container-lowest);
  box-shadow: 0 1px 2px rgba(3, 37, 23, 0.06);
  min-width: 0;
}

.st-ava,
image.st-ava {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: block;
  flex: none;
}

.st-user-main {
  flex: 1;
  min-width: 0;
}

.st-name {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.st-meta {
  display: block;
  color: var(--on-surface-variant);
  margin-top: 2px;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sec-lab {
  display: block;
  margin: 20px 16px 8px;
  font-family: var(--sans);
  font-size: 10px;
  line-height: 14px;
  font-weight: 700;
  color: var(--secondary);
  letter-spacing: 0.1em;
}

.st-group {
  width: auto;
  margin: 0 16px;
  border-radius: 16px;
  overflow: hidden;
  background: var(--surface-container-lowest);
  box-shadow: 0 1px 2px rgba(3, 37, 23, 0.06);
}

.nf-row,
.pol-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 16px;
  min-width: 0;
}

.nf-row + .nf-row,
.pol-row + .pol-row {
  border-top: 1px solid var(--surface-container);
}

.nf-copy,
.pol-copy {
  flex: 1;
  min-width: 0;
  padding-right: 12px;
}

.nf-title,
.pol-title {
  display: block;
  min-width: 0;
  word-break: break-word;
}

.nf-desc,
.pol-sub {
  display: block;
  color: var(--on-surface-variant);
  margin-top: 2px;
  min-width: 0;
  word-break: break-word;
}

.pol-left {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 0;
}

.lang-row {
  display: flex;
  gap: 8px;
  width: auto;
  margin: 0 16px;
  padding: 8px;
  border-radius: 16px;
  background: var(--surface-container-lowest);
  box-shadow: 0 1px 2px rgba(3, 37, 23, 0.06);
}

.lang-btn {
  flex: 1;
  height: 40px;
  border-radius: 12px;
  background: var(--surface-container);
  color: var(--on-surface);
  font-family: var(--sans);
  font-size: 12px;
  line-height: 40px;
  font-weight: 600;
}

.lang-btn.is-on {
  background: var(--primary);
  color: var(--on-primary);
}

.clear-btn {
  width: auto;
  margin: 16px 16px 0;
  height: 44px;
  border-radius: 12px;
  background: var(--surface-container-high);
  color: var(--on-surface);
  font-family: var(--sans);
  font-size: 12px;
  line-height: 44px;
  font-weight: 600;
}

.foot {
  display: block;
  text-align: center;
  color: var(--outline);
  margin-top: 20px;
}
