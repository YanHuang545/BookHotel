.page-body { padding-top: 12px; }

.gutter {
  margin-left: 16px;
  margin-right: 16px;
}

.kicker {
  display: block;
  font-family: var(--sans);
  font-size: 10px;
  line-height: 14px;
  font-weight: 700;
  color: var(--secondary);
  letter-spacing: 0.1em;
}

.intro-title { display: block; margin-top: 0; }

.intro-desc {
  display: block;
  color: var(--on-surface-variant);
  margin-top: 4px;
  margin-bottom: 16px;
}

.coupon-card {
  display: flex;
  width: auto;
  margin: 0 16px 12px;
  border-radius: 16px;
  overflow: hidden;
  background: var(--surface-container-lowest);
  box-shadow: 0 1px 2px rgba(3, 37, 23, 0.06);
}

.coupon-card.is-muted {
  background: var(--surface-container);
  opacity: 0.7;
}

.cp-gold {
  width: 96px;
  flex: none;
  background: var(--secondary);
  color: var(--on-secondary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px 8px;
}

.cp-amt {
  display: block;
  color: var(--on-secondary);
  line-height: 32px;
  white-space: nowrap;
}

.cp-off {
  display: block;
  color: var(--on-secondary);
  white-space: nowrap;
}

.cp-main {
  flex: 1;
  min-width: 0;
  padding: 16px;
}

.cp-title {
  display: block;
  min-width: 0;
  word-break: break-word;
}

.cp-note {
  display: block;
  color: var(--on-surface-variant);
  margin-top: 4px;
  min-width: 0;
  word-break: break-word;
}

.use-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  margin-top: 8px;
  padding: 4px 12px;
  border-radius: 8px;
  background: var(--surface-container);
  color: var(--on-surface);
  font-family: var(--sans);
  font-size: 12px;
  line-height: 16px;
  font-weight: 600;
}

.use-btn.is-on {
  background: var(--primary);
  color: var(--on-primary);
}

.cp-dead {
  display: inline-block;
  color: var(--outline);
  margin-top: 8px;
}
