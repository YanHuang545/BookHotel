.page-body { padding-top: 12px; }

.gutter {
  margin-left: 16px;
  margin-right: 16px;
}

.kicker {
  display: block;
  font-family: var(--sans);
  font-size: 10px;
  line-height: 14px;
  font-weight: 700;
  color: var(--secondary);
  letter-spacing: 0.1em;
}

.intro-title {
  display: block;
  margin-top: 4px;
}

.intro-desc {
  display: block;
  color: var(--on-surface-variant);
  margin-top: 4px;
  margin-bottom: 16px;
}

.brand-card {
  width: auto;
  margin: 0 16px 16px;
  border-radius: 16px;
  overflow: hidden;
  background: var(--surface-container-lowest);
  box-shadow: 0 1px 2px rgba(3, 37, 23, 0.06);
}

.brand-cover-wrap {
  height: 160px;
  overflow: hidden;
}

.brand-cover,
image.brand-cover {
  width: 100%;
  height: 160px;
  display: block;
  flex: none;
}

.brand-body { padding: 16px; }

.brand-tag {
  background: var(--surface-container);
  color: var(--on-surface-variant);
}

.brand-name {
  display: block;
  margin-top: 8px;
}

.brand-long {
  display: block;
  color: var(--on-surface-variant);
  margin-top: 4px;
  line-height: 1.625;
  min-width: 0;
  word-break: break-word;
}

.brand-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  margin-top: 12px;
  padding: 8px 16px;
  border-radius: 8px;
  background: var(--primary);
  color: var(--on-primary);
  font-family: var(--sans);
  font-size: 12px;
  line-height: 16px;
  font-weight: 600;
}
