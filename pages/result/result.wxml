<view class="page-root page-stack" style="padding-top: {{navBarHeight}}px;">
  <nav-bar title="Confirmed" pageLabel="Confirmed" showBack="{{true}}" showBrand="{{false}}"></nav-bar>

  <view class="result-wrap">
    <view class="ok-ico">
      <icon-mask name="check_circle" size="32" color="#032517"></icon-mask>
    </view>
    <text class="t-headline-md result-title">预订已锁定</text>
    <text class="result-sub">管家将在 30 分钟内致电确认抵达行程</text>

    <view wx:if="{{hasOrder}}" class="order-card">
      <view class="order-cover">
        <image class="order-cover-img" src="{{order.cover}}" mode="aspectFill"></image>
      </view>
      <view class="order-body">
        <text class="order-id">订单号 {{order.id}}</text>
        <text class="order-name">{{order.resortName}}</text>
        <text class="order-room">{{order.roomName}}</text>
        <text class="order-dates">{{order.inLabel}} — {{order.outLabel}} · {{order.nights}}晚</text>
        <text class="order-pay">{{order.pay}}</text>
      </view>
    </view>

    <view class="result-btns">
      <view class="btn-ghost" bindtap="goOrders">
        <text>查看订单</text>
      </view>
      <view class="btn-pri" bindtap="goHome">
        <text>回首页</text>
      </view>
    </view>
  </view>
</view>
